rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      // 15MB max file size per image
      return request.resource.size < 15 * 1024 * 1024;
    }

    // 1. Book Listing Images:
    // Completely public read access for all buyers, students, and guests across all devices.
    // Writes restricted to authenticated users uploading valid image files under 15MB.
    match /book_images/{imageFile} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    match /book_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    // 2. User Profile Pictures:
    // Public read so sellers and buyers can view profile avatars across campus.
    match /profile_images/{imageFile} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    match /profile_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile() && isValidSize();
      allow delete: if isAuthenticated();
    }

    // Default fallback: deny unauthenticated writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
