rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      // 15MB max file size per image
      return request.resource.size < 15 * 1024 * 1024;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Book Listing Images:
    // Public read access for all buyers, students, and guests across all devices.
    // Writes permitted for valid image files under 15MB.
    // Deletions allowed for authenticated users.
    match /book_images/{imageFile} {
      allow read: if true;
      allow write: if isImageFile() && isValidSize();
      allow delete: if isAuthenticated() && (
        resource.metadata.userId == null ||
        resource.metadata.userId == request.auth.uid
      );
    }

    match /book_images/{allPaths=**} {
      allow read: if true;
      allow write: if isImageFile() && isValidSize();
      allow delete: if isAuthenticated() && (
        resource.metadata.userId == null ||
        resource.metadata.userId == request.auth.uid
      );
    }

    // 2. User Profile Pictures:
    // Public read so sellers and buyers can view profile avatars across campus.
    // Writes permitted for valid image files under 15MB.
    match /profile_images/{imageFile} {
      allow read: if true;
      allow write: if isImageFile() && isValidSize();
      allow delete: if isAuthenticated() && (
        resource.metadata.userId == request.auth.uid ||
        imageFile.matches('^' + request.auth.uid + '_.*')
      );
    }

    match /profile_images/{allPaths=**} {
      allow read: if true;
      allow write: if isImageFile() && isValidSize();
      allow delete: if isAuthenticated() && (
        resource.metadata.userId == request.auth.uid
      );
    }

    // 3. User-specific directory uploads:
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || !isAuthenticated()) && isImageFile() && isValidSize();
      allow delete: if isOwner(userId);
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isImageFile() && isValidSize();
    }
  }
}
