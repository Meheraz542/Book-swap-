rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Student Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Semester Book Set Listings (Public Catalog)
    match /bookSets/{bookSetId} {
      allow read, write: if true;
    }

    // Conversations between Buyer and Seller
    match /conversations/{conversationId} {
      allow read, write: if true;

      // Messages inside Conversation
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Campus Meetup & Mega Deals (Public Catalog)
    match /megaDeals/{dealId} {
      allow read, write: if true;
    }
  }
}
