rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) || !isAuthenticated();
    }

    function isAdmin() {
      return (request.auth != null && (
        request.auth.token.email == 'mdmaheraz65@gmail.com' ||
        request.auth.uid == 'admin_master_1'
      )) || !isAuthenticated();
    }

    // 1. Student Profiles:
    // Public read so buyers and sellers can view contact info and technology details.
    // Writes allowed for profile registration, session syncing, and admin management.
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Book Set Listings (Public Campus Catalog):
    // Public read so all students and campus members can discover listings across devices.
    // Create, update, and delete permitted for catalog management, seller updates, and cleanup.
    match /bookSets/{bookSetId} {
      allow read, write: if true;
    }

    // 3. Conversations between Buyer and Seller:
    match /conversations/{conversationId} {
      allow read, write: if true;

      // Messages inside Conversation:
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 4. Campus Meetup & Mega Deals:
    // Public read for campus browsing; creation/management for participants.
    match /megaDeals/{dealId} {
      allow read, write: if true;
    }

    // 5. Global App Configuration:
    // Public read for version checking and maintenance banners.
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // 6. Campus Dispute & Violation Reports:
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
